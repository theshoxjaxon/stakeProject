# Copy to `.env` and fill in. Never commit `.env`.

# --- Database (PostgreSQL only) ---
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/stakeproject

# --- Auth (src/core/security.py) ---
# Required — signs/verifies access tokens (JWT HS256). No default; the app
# refuses to start without it. Use 32+ random bytes, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# --- Redis (src/api/deps.py: plan-check cache, daily rate limiting) ---
# REDIS_URL=redis://localhost:6379/0

# --- CORS (src/api/__init__.py) ---
# Exactly one origin — the dashboard's. Never a wildcard or a list: CORS is
# configured with allow_credentials=True, and allow_origins=["*"] with
# credentials is a real cross-origin credential leak, not just a lint nag.
# DASHBOARD_ORIGIN=http://localhost:5173

# --- The Odds API ---
ODDS_API_KEY=

# --- Gemini AI advisor (optional; pipeline runs pure-quant without it) ---
# GEMINI_API_KEY=
# AI_ADVISOR_ENABLED=true
# GEMINI_MODEL=gemini-3.1-pro-preview

# --- Tournament auto-detection ---
# When a candidate tournament is in season (World Cup, Euros, UCL, ...) its
# matches join the update cycle automatically. Detection uses the free
# /v4/sports endpoint and is cached for SPORTS_CACHE_TTL_HOURS.
# TOURNAMENT_AUTO_DETECT=true
# TOURNAMENT_SPORT_KEYS=soccer_fifa_world_cup,soccer_uefa_european_championship,soccer_uefa_champs_league,soccer_uefa_europa_league,soccer_conmebol_copa_america
# SPORTS_CACHE_TTL_HOURS=12

# --- xG scrape (FBref via soccerdata) — slow, rate-limited; opt in ---
# XG_SYNC_ENABLED=false

# --- Predictions ---
# Only matches with kickoff in the next N days (omit for no upper limit)
# PREDICTION_HORIZON_DAYS=7

# Minimum model edge vs de-margined fair implied (e.g. 0.05 = 5%)
# EDGE_THRESHOLD=0.05

# If true, main.py prints only value-bet lines (compact). Default: false = all upcoming matches with odds.
# SHOW_ONLY_VALUE_BETS=false

# Fractional Kelly multiplier applied to full Kelly stake
# KELLY_FRACTION=0.25

# Reference bankroll for display / sizing (optional)
# DEFAULT_BANKROLL=1000

# --- Feature engineering (Poisson λ multipliers) ---
# FEATURES_ENABLED=true
# FORM_WINDOW=10
# FORM_WEIGHT=0.08
# H2H_WEIGHT=0.06
# REST_SHORT_DAYS=3
# REST_FATIGUE_FACTOR=0.97
# MIDWEEK_FATIGUE_FACTOR=0.99

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_DIR=data/logs
# LOG_FILE=betting_engine.log

# --- Sports (comma-separated keys) ---
# DEFAULT_SPORTS=soccer_epl,soccer_spain_la_liga,soccer_germany_bundesliga
